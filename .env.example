# Copy to .env and fill in. .env is git-ignored; never commit real values.

PORT=3000
# Public address of the site; used in canonical links, robots.txt and sitemap.xml.
SITE_URL=https://your-domain.com

# ---------- Firebase (server) ----------
# Firebase console > Project settings > General
FIREBASE_PROJECT_ID=your-project-id
# Firebase console > Storage (the bucket name, without gs://)
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# Firebase console > Project settings > Service accounts > Generate new private key.
# Paste the whole JSON on one line, or base64-encode it. Leave empty on Google Cloud
# hosting (Cloud Run / App Hosting), where the runtime service account is used instead.
FIREBASE_SERVICE_ACCOUNT=

# Admin access to /#admin is not set here. Add a document to the Firestore `admins`
# collection whose document ID is the admin's Google email, in lowercase.

# ---------- Firebase (browser: Google sign-in for the admin) ----------
# Firebase console > Project settings > General > Your apps > Web app config.
# These are public identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=
# Set to true to use the local Firebase emulators instead of the real project.
VITE_USE_FIREBASE_EMULATORS=false

# ---------- Booking emails (SMTP) ----------
# After each booking the patient and the clinic get an email (see server/bookingEmail.ts).
# Set the same values in Vercel: Project > Settings > Environment Variables.
# GoDaddy Workspace / Professional Email: smtpout.secureserver.net, port 465 (SSL).
# GoDaddy Microsoft 365 email: smtp.office365.com, port 587.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
# The full mailbox address.
SMTP_USER=you@your-domain.com
# The mailbox password. Never commit it.
SMTP_PASS=
# Sender shown to recipients; GoDaddy requires the address to be SMTP_USER. Defaults to SMTP_USER.
SMTP_FROM="Clinic Name <you@your-domain.com>"
# Where new-booking alerts for the clinic owner go.
CLINIC_NOTIFY_EMAIL=you@your-domain.com

# ---------- Disabled in V1 (payments, WhatsApp) ----------
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
