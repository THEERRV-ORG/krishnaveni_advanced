# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ========================================================
# PRODUCTION CI/CD & SERVER ENVIRONMENT CONFIGURATION
# ========================================================
PORT=3000
NODE_ENV=production

# Database Connection (e.g. PostgreSQL, Cloud SQL, Supabase, Neon)
DATABASE_URL=postgresql://physiouser:password@localhost:5432/physiodb

# Admin Authentication
ADMIN_EMAIL=admin@krishnaveniphysio.com
ADMIN_PASSWORD=YourSecureAdminPassword123!
JWT_SECRET=your_32_character_jwt_secret_phrase

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email Notifications (SMTP, Resend, or SendGrid)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Krishnaveni Physiotherapy <krishnavenirehab@gmail.com>"
RESEND_API_KEY=
SENDGRID_API_KEY=

# Clinic WhatsApp Automated Dispatch (From Clinic +91 94906 05809 to Patient)
# Option 1: Meta WhatsApp Business Cloud API (Official - Free 1,000 conversations/mo + ~12-15 paise/msg)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_WEBHOOK_VERIFY_TOKEN="krishnaveni_webhook_secret"
# Option 2: Twilio WhatsApp API
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
# Option 3: Fast2SMS API (Direct Indian Mobile Dispatch)
FAST2SMS_API_KEY=
# Option 4: Universal WhatsApp Webhook (Zapier, Make, n8n, AiSensy, Gupshup)
WHATSAPP_WEBHOOK_URL=
